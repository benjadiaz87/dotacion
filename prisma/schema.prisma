generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  location    String?
  client      String?
  startDate   DateTime
  weeks       Int
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId    String
  user      User       @relation(fields: [userId], references: [id])
  weekPlans WeekPlan[]
  curveChanges CurveChangeLog[]

  @@map("projects")
}

model Role {
  id       String @id @default(cuid())
  name     String @unique
  category String @default("OPERATIVO")
  color    String @default("#3b82f6")

  requirements  RoleRequirement[]
  assignments   WorkerAssignment[]
  stageReqs     StageDocRequirement[]
  workers       Worker[]

  @@map("roles")
}

model Worker {
  id                String   @id @default(cuid())
  rut               String   @unique
  fullName          String
  phone             String?
  email             String?
  createdAt         DateTime @default(now())
  currentStageOrder Int      @default(1)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  documents     WorkerDocument[]
  assignments   WorkerAssignment[]
  exceptions    WorkerDocException[]
  uploadTokens  WorkerUploadToken[]

  @@map("workers")
}

model DocumentType {
  id       String  @id @default(cuid())
  name     String  @unique
  required Boolean @default(true)

  documents    WorkerDocument[]
  stageReqs    StageDocRequirement[]
  exceptions   WorkerDocException[]

  @@map("document_types")
}

model Stage {
  id          String  @id @default(cuid())
  order       Int     @unique
  name        String  @unique
  type        String  // "PROCESO" | "HITO"
  description String?

  requirements StageDocRequirement[]
  exceptions   WorkerDocException[]

  @@map("stages")
}

model StageDocRequirement {
  id String @id @default(cuid())

  stageId        String
  stage          Stage        @relation(fields: [stageId], references: [id])

  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  @@unique([stageId, documentTypeId, roleId])
  @@map("stage_doc_requirements")
}

model WorkerUploadToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_upload_tokens")
}

model WorkerDocException {
  id            String   @id @default(cuid())
  justification String
  createdAt     DateTime @default(now())
  createdBy     String   @default("admin")

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  @@map("worker_doc_exceptions")
}

model WorkerDocument {
  id             String   @id @default(cuid())
  status         String   @default("PENDING")
  fileUrl        String
  fileName       String
  documentNumber String?
  verifyNote     String?  // último resultado de verificación fallida (ej: RUT no coincide)
  expiresAt      DateTime? // vencimiento del documento (exámenes, licencias)
  issuedAt       DateTime? // fecha de emisión (ej: certificado de antecedentes)
  extractedData  String?   // JSON con todos los datos leídos por la IA
  uploadedAt     DateTime @default(now())

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  @@unique([workerId, documentTypeId])
  @@map("worker_documents")
}

model WorkerAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  weekPlanId String
  weekPlan   WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([workerId, weekPlanId])
  @@map("worker_assignments")
}

model WeekPlan {
  id         String   @id @default(cuid())
  weekNumber Int
  startDate  DateTime
  endDate    DateTime
  notes      String?

  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirements RoleRequirement[]
  assignments  WorkerAssignment[]

  @@unique([projectId, weekNumber])
  @@map("week_plans")
}

model RoleRequirement {
  id       String @id @default(cuid())
  quantity Int    @default(1)

  weekPlanId String
  weekPlan   WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([weekPlanId, roleId])
  @@map("role_requirements")
}

model AlertSetting {
  id                  String  @id @default("default")
  gapsEnabled         Boolean @default(true)
  gapsSemanas         Int     @default(3)  // horizonte de detección de gaps
  salidasEnabled      Boolean @default(true)
  salidasSemanas      Int     @default(3)
  vencimientosEnabled Boolean @default(true)
  vencimientoDias     Int     @default(30) // anticipación del aviso de vencimiento
  curvaEnabled        Boolean @default(true)
  updatedAt           DateTime @updatedAt

  @@map("alert_settings")
}

model CurveChangeLog {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekNumber Int
  roleName   String
  oldQty     Int
  newQty     Int
  changedBy  String   @default("admin")
  createdAt  DateTime @default(now())

  @@map("curve_change_logs")
}

model FeatureRequest {
  id          String   @id @default(cuid())
  titulo      String
  tipo        String   // FEATURE | MEJORA | BUG
  area        String   // dashboard | proyectos | pipeline | documentos | alertas | cargos | otra
  prioridad   String   // ALTA | MEDIA | BAJA
  problema    String   // qué problema resuelve / por qué importa
  comportamiento String // comportamiento esperado, paso a paso
  criterios   String   // criterios de aceptación ("listo cuando…")
  pantalla    String?  // dónde vive en la app (pantalla / URL)
  images      String?  // JSON array de URLs de capturas adjuntas
  status      String   @default("NUEVA") // NUEVA | EN_DESARROLLO | HECHA | DESCARTADA
  createdBy   String   // nombre del solicitante
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_requests")
}
